# SwagStack Studio → Supabase kxibxwvigejfzbhkksgu (eu-west-1)
# Keys: https://supabase.com/dashboard/project/kxibxwvigejfzbhkksgu/settings/api
# Wire locally: node scripts/connect-supabase.mjs
# Apply schema: supabase/swagstack_schema.sql in the SQL editor first.

VITE_SUPABASE_URL=https://kxibxwvigejfzbhkksgu.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-only (never VITE_*): seed/admin scripts
# SUPABASE_URL=https://kxibxwvigejfzbhkksgu.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SEED_ADMIN_EMAIL=mukundimukhuba8@gmail.com
# SEED_ADMIN_PASSWORD=

# Public PayFast fields (never put the passphrase in VITE_*)
VITE_PAYFAST_MERCHANT_ID=
VITE_PAYFAST_MERCHANT_KEY=
VITE_PAYFAST_SANDBOX=true
VITE_PAYFAST_PASS_CONFIGURED=false

# Server-only PayFast secrets (Vercel env, no VITE_ prefix)
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true

# Stripe (public publishable key may use VITE_; secret must stay server-only)
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: email that becomes super_admin on first signup via DB setting
# set_config in SQL: select set_config('app.ss_bootstrap_admin_email', 'you@example.com', false);
